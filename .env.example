PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=invo_db

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
APP_NAME=Your Application Name

# Email Configuration (SMTP)
# For Gmail: Use App Password (not regular password) - Enable 2FA and generate app password
# For Outlook: Use your email and password
# For other providers: Check their SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-email-password
SMTP_SERVICE=gmail
EMAIL_FROM=noreply@yourdomain.com

# Admin User (optional - for create-admin script)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@invo.com
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin
